#!/bin/bash
# shellcheck disable=SC1091,SC2086,SC1001,SC2317

#==============================================================================
# node_install - cardano-node インストール
#==============================================================================

recommend_node_version="10.5.3"
recommend_cli_version="10.11.0.0"
recommend_cabal_version="3.12.1.0"
recommend_ghc_version="9.6.5"


#==============================================================================
# ソースビルド用サブ関数 (プレビルドバイナリが利用できない場合のみ)
#==============================================================================

LibsodiumInstall(){
  sleep 3
  cd ${HOME}/git || return 1
  git clone https://github.com/IntersectMBO/libsodium
  cd libsodium || return 1
  git checkout $SODIUM_VERSION
  ./autogen.sh
  ./configure
  make
  sudo make install
  DglayStyle "Libsodium インストール完了"
}

Secp256k1Install(){
  sleep 3
  cd ${HOME}/git || return 1
  git clone https://github.com/bitcoin-core/secp256k1.git
  cd secp256k1/ || return 1
  git checkout $SECP256K1_VERSION
  ./autogen.sh
  ./configure --prefix=/usr --enable-module-schnorrsig --enable-experimental
  make
  sudo make install
  DglayStyle "Secp256k1 インストール完了"
}

BlstInstall(){
  sleep 3
  cd ${HOME}/git || return 1
  git clone https://github.com/supranational/blst
  cd blst || return 1
  git checkout $BLST_VERSION
  ./build.sh

  cat <<-EOF >libblst.pc
		prefix=/usr/local
		exec_prefix=\${prefix}
		libdir=\${exec_prefix}/lib
		includedir=\${prefix}/include

		Name: libblst
		Description: Multilingual BLS12-381 signature library
		URL: https://github.com/supranational/blst
		Version: ${BLST_VERSION#v}
		Cflags: -I\${includedir}
		Libs: -L\${libdir} -lblst
		EOF

  sudo cp libblst.pc /usr/local/lib/pkgconfig/
  sudo cp bindings/blst_aux.h bindings/blst.h bindings/blst.hpp /usr/local/include/
  sudo cp libblst.a /usr/local/lib
  sudo chmod u=rw,go=r /usr/local/{lib/{libblst.a,pkgconfig/libblst.pc},include/{blst.{h,hpp},blst_aux.h}}
  DglayStyle "blst インストール完了"
}

GhcupInstall(){
  sleep 3
  cd ${HOME} || return 1
  BOOTSTRAP_HASKELL_NONINTERACTIVE=1
  BOOTSTRAP_HASKELL_NO_UPGRADE=1
  BOOTSTRAP_HASKELL_ADJUST_BASHRC=1
  unset BOOTSTRAP_HASKELL_INSTALL_HLS
  export BOOTSTRAP_HASKELL_NONINTERACTIVE BOOTSTRAP_HASKELL_NO_UPGRADE BOOTSTRAP_HASKELL_ADJUST_BASHRC

  curl -s --proto '=https' --tlsv1.2 -sSf https://get-ghcup.haskell.org | bash

  source ${HOME}/.ghcup/env
  ghcup upgrade
  ghcup install cabal $recommend_cabal_version
  ghcup set cabal $recommend_cabal_version
  ghcup install ghc $recommend_ghc_version
  ghcup set ghc $recommend_ghc_version

  cabal update
  cabal --version; ghc --version
  DglayStyle "GHCUP インストール完了"
}


#==============================================================================
# NodeConfigDownload - ノード設定ファイル一式ダウンロード
#==============================================================================

NodeConfigDownload(){
  LglayStyle "ノード設定ファイルをダウンロード中..."
  mkdir -p "${NODE_HOME}"
  cd "${NODE_HOME}" || return 1

  local base="https://spojapanguild.net/node_config/${recommend_node_version}"
  local ok=true

  for fname in \
    "${NODE_CONFIG}-byron-genesis.json" \
    "${NODE_CONFIG}-shelley-genesis.json" \
    "${NODE_CONFIG}-alonzo-genesis.json" \
    "${NODE_CONFIG}-conway-genesis.json" \
    "${NODE_CONFIG}-topology.json" \
    "${NODE_CONFIG}-checkpoints.json" \
    "${NODE_CONFIG}-peer-snapshot.json"; do
    if wget -q "${base}/${fname}" -O "${fname}" 2>/dev/null; then
      echo -e "  ${GREEN}✓${NC} ${fname}"
    else
      echo -e "  ${YELLOW}⚠ ${fname} の取得に失敗しました${NC}"
      ok=false
    fi
  done

  if wget -q "${base}/${NODE_CONFIG}-config.json" -O "${NODE_CONFIG}-config.json" 2>/dev/null; then
    echo -e "  ${GREEN}✓${NC} ${NODE_CONFIG}-config.json"
  else
    echo -e "  ${YELLOW}⚠ config.json の取得に失敗しました${NC}"
    ok=false
  fi

  if [[ "$ok" == "true" ]]; then
    DglayStyle "ノード設定ファイルをダウンロードしました"
  else
    echo -e "${YELLOW}一部のファイル取得に失敗しました。後で再取得してください。${NC}"
  fi
  echo
}


#==============================================================================
# GliveViewDownload - gLiveView セットアップ
#==============================================================================

GliveViewDownload(){
  LglayStyle "gLiveView をセットアップ中..."
  mkdir -p "${NODE_HOME}/scripts"
  cd "${NODE_HOME}/scripts" || return 1

  sudo apt-get install bc tcptraceroute -y > /dev/null 2>&1

  curl -s -o gLiveView.sh \
    https://raw.githubusercontent.com/cardano-community/guild-operators/master/scripts/cnode-helper-scripts/gLiveView.sh
  curl -s -o env \
    https://raw.githubusercontent.com/cardano-community/guild-operators/master/scripts/cnode-helper-scripts/env
  chmod 755 gLiveView.sh

  sed -i "${NODE_HOME}/scripts/env" \
    -e '1,73s!#CNODE_HOME="/opt/cardano/cnode"!CNODE_HOME="'"${NODE_HOME}"'"!' \
    -e '1,73s!#CNODE_PORT=6000!CNODE_PORT='"${1}"'!' \
    -e '1,73s!#UPDATE_CHECK="Y"!UPDATE_CHECK="N"!' \
    -e '1,73s!#PROM_HOST=127.0.0.1!PROM_HOST=127.0.0.1!' \
    -e '1,73s!#PROM_PORT=12798!PROM_PORT=12798!' \
    -e '1,73s!#CONFIG="${CNODE_HOME}/files/config.json"!CONFIG="${CNODE_HOME}/'"${NODE_CONFIG}"'-config.json"!' \
    -e '1,73s!#SOCKET="${CNODE_HOME}/sockets/node0.socket"!SOCKET="${CNODE_HOME}/db/socket"!'

  DglayStyle "gLiveView をセットアップしました"
  echo
}


#==============================================================================
# NodeInstall - メインインストール関数
#==============================================================================

NodeInstall(){
  clear
  Header "ノードインストール"

  #------------------------------------------------------------
  # インストール済みチェック
  #------------------------------------------------------------
  if command -v cardano-node >/dev/null 2>&1; then
    local cur_node cur_cli
    cur_node=$(cardano-node version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1 || echo "不明")
    cur_cli=$(cardano-cli  version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1 || echo "不明")
    echo -e "${YELLOW}cardano-node はすでにインストールされています${NC}"
    printf "  %-16s ${GREEN}%s${NC}\n" "cardano-node:" "$cur_node"
    printf "  %-16s ${GREEN}%s${NC}\n" "cardano-cli:"  "$cur_cli"
    echo
    Gum_OneSelect "戻る"
    return
  fi

  #------------------------------------------------------------
  # インストールするバージョン表示
  #------------------------------------------------------------
  echo -e "${YELLOW}インストールするバージョン:${NC}"
  printf "  %-16s ${CYAN}%s${NC}\n" "cardano-node:" "$recommend_node_version"
  printf "  %-16s %s\n"             "cardano-cli:"  "cardano-nodeにパッケージ済み"
  echo

  echo -e "${YELLOW}インストール内容:${NC}"
  echo "  ・cardano-node / cardano-cli (プレビルドバイナリ)"
  echo "  ・ノード設定ファイル一式 (SPO JAPAN GUILD)"
  echo "  ・起動スクリプト"
  echo "  ・gLiveView"
  echo "  ・systemd サービス (cardano-node)"
  echo

  #------------------------------------------------------------
  # ノード起動ポート選択
  #------------------------------------------------------------
  select_port "node"
  echo

  #------------------------------------------------------------
  # DB同期方法の選択
  #------------------------------------------------------------
  echo -e "${YELLOW}初回DB同期方法について${NC}"
  echo "  Mithril: スナップショットから最速同期 (推奨・30分以上)"
  echo "  通常起動: ジェネシスブロックから同期 (数日かかる場合があります)"
  echo
  local sync_method
  sync_method=$(gum choose --height=4 --no-show-help \
    --header="DB同期方法を選択してください" \
    --header.foreground="244" \
    "Mithrilスナップショットで同期 (推奨・最速)" \
    "通常起動 (ジェネシスから同期)") || return
  echo

  #------------------------------------------------------------
  # 最終確認
  #------------------------------------------------------------
  local node_run_filename
  case "$NODE_TYPE" in
    "ブロックプロデューサー" ) node_run_filename="startBlockProducingNode.sh" ;;
    "リレー"               ) node_run_filename="startRelayNode1.sh" ;;
  esac

  echo -e "${WHITE}============================================${NC}"
  echo -e "${YELLOW}  インストール内容の確認${NC}"
  echo -e "${WHITE}============================================${NC}"
  printf "  %-20s ${CYAN}%s${NC}\n"  "cardano-node:"     "$recommend_node_version"
  printf "  %-20s %s\n"              "ノードタイプ:"     "$NODE_TYPE"
  printf "  %-20s %s\n"              "ネットワーク:"     "$NODE_CONFIG"
  printf "  %-20s %s\n"              "ポート番号:"       "$port_number"
  printf "  %-20s %s\n"              "作業ディレクトリ:" "$NODE_HOME"
  printf "  %-20s %s\n"              "DB同期:" \
    "$([[ "$sync_method" == *Mithril* ]] && echo "Mithrilで同期" || echo "ジェネシスから通常同期")"
  echo -e "${WHITE}============================================${NC}"
  echo

  if ! Gum_Confirm "この内容でインストールを実行しますか？"; then
    return
  fi

  #------------------------------------------------------------
  # STEP 1: Ubuntu パッケージアップデート
  #------------------------------------------------------------
  LglayStyle "Ubuntu パッケージをアップデート中..."
  SystemUpdate
  Installdependencies
  echo

  #------------------------------------------------------------
  # STEP 2: バイナリダウンロード
  #------------------------------------------------------------
  local dl_dir="$HOME/git/cardano-node-install"
  rm -rf "$dl_dir" && mkdir -p "$dl_dir"

  local tar_url="https://github.com/IntersectMBO/cardano-node/releases/download/${recommend_node_version}/cardano-node-${recommend_node_version}-linux-amd64.tar.gz"
  local tar_file="$dl_dir/cardano-node-${recommend_node_version}-linux-amd64.tar.gz"

  gum spin --spinner dot \
    --title "cardano-node v${recommend_node_version} をダウンロード中..." -- \
    wget -q "$tar_url" -O "$tar_file"
  if [ $? -ne 0 ] || ! gzip -t "$tar_file" 2>/dev/null; then
    echo -e "${RED}ダウンロードに失敗しました。インターネット接続を確認してください。${NC}"
    rm -rf "$dl_dir"
    Gum_OneSelect "戻る"
    return
  fi

  gum spin --spinner dot --title "展開中..." -- \
    tar zxf "$tar_file" -C "$dl_dir" \
      ./bin/cardano-node ./bin/cardano-cli ./bin/snapshot-converter 2>/dev/null
  if [ $? -ne 0 ]; then
    tar zxf "$tar_file" -C "$dl_dir" 2>/dev/null || true
  fi
  rm -f "$tar_file"

  local node_bin cli_bin snap_conv_bin
  node_bin=$(find "$dl_dir" -type f -name "cardano-node"          2>/dev/null | head -1)
  cli_bin=$(find  "$dl_dir" -type f -name "cardano-cli"           2>/dev/null | head -1)
  snap_conv_bin=$(find "$dl_dir" -type f -name "snapshot-converter" 2>/dev/null | head -1)

  if [[ -z "$node_bin" ]]; then
    echo -e "${RED}cardano-node バイナリが見つかりません。${NC}"
    rm -rf "$dl_dir"
    Gum_OneSelect "戻る"
    return
  fi

  local new_node new_cli
  new_node=$("$node_bin" version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1 || echo "確認失敗")
  new_cli=$([[ -n "$cli_bin" ]] && "$cli_bin" version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1 || echo "")

  echo -e "${YELLOW}ダウンロードしたバイナリのバージョン:${NC}"
  printf "  %-16s ${GREEN}%s${NC}\n" "cardano-node:" "$new_node"
  [[ -n "$new_cli" ]] && printf "  %-16s ${GREEN}%s${NC}\n" "cardano-cli:" "$new_cli"
  echo

  #------------------------------------------------------------
  # STEP 3: バイナリ配置
  #------------------------------------------------------------
  LglayStyle "バイナリを配置中..."
  sudo cp "$node_bin" /usr/local/bin/cardano-node
  [[ -n "$cli_bin" ]] && sudo cp "$cli_bin" /usr/local/bin/cardano-cli
  [[ -n "$snap_conv_bin" ]] && sudo cp "$snap_conv_bin" /usr/local/bin/snapshot-converter
  rm -rf "$dl_dir"
  DglayStyle "バイナリを配置しました"
  echo -e "  cardano-node: ${GREEN}$(cardano-node version 2>/dev/null | head -1)${NC}"
  [[ -n "$cli_bin" ]] && echo -e "  cardano-cli:  ${GREEN}$(cardano-cli version 2>/dev/null | head -1)${NC}"
  echo

  #------------------------------------------------------------
  # STEP 4: 設定ファイルダウンロード
  #------------------------------------------------------------
  NodeConfigDownload

  #------------------------------------------------------------
  # STEP 5: 起動スクリプト作成
  #------------------------------------------------------------
  LglayStyle "起動スクリプトを作成中..."
  mkdir -p "${NODE_HOME}"

  cat > "${NODE_HOME}/${node_run_filename}" <<EOF
#!/bin/bash
DIRECTORY=${NODE_HOME}
PORT=${port_number}
HOSTADDR=0.0.0.0
TOPOLOGY=\${DIRECTORY}/${NODE_CONFIG}-topology.json
DB_PATH=\${DIRECTORY}/db
SOCKET_PATH=\${DIRECTORY}/db/socket
CONFIG=\${DIRECTORY}/${NODE_CONFIG}-config.json
/usr/local/bin/cardano-node +RTS -N --disable-delayed-os-memory-return -I0.1 -Iw300 -A16m -F1.5 -H2500M -RTS run \\
  --topology \${TOPOLOGY} \\
  --database-path \${DB_PATH} \\
  --socket-path \${SOCKET_PATH} \\
  --host-addr \${HOSTADDR} \\
  --port \${PORT} \\
  --config \${CONFIG}
EOF

  chmod +x "${NODE_HOME}/${node_run_filename}"
  DglayStyle "起動スクリプトを作成しました"
  echo

  #------------------------------------------------------------
  # STEP 6: gLiveView セットアップ
  #------------------------------------------------------------
  GliveViewDownload "$port_number"

  #------------------------------------------------------------
  # STEP 7: systemd サービス作成
  #------------------------------------------------------------
  LglayStyle "systemd サービスを作成中..."

  cat > "${NODE_HOME}/cardano-node.service" <<EOF
# The Cardano node service (part of systemd)
# file: /etc/systemd/system/cardano-node.service

[Unit]
Description     = Cardano node service
Wants           = network-online.target
After           = network-online.target

[Service]
User            = ${USER}
Type            = simple
WorkingDirectory= ${NODE_HOME}
ExecStart       = /bin/bash -c '${NODE_HOME}/${node_run_filename}'
KillSignal=SIGINT
RestartKillSignal=SIGINT
TimeoutStopSec=300
LimitNOFILE=32768
Restart=always
RestartSec=5
SyslogIdentifier=cardano-node

[Install]
WantedBy    = multi-user.target
EOF

  sudo cp "${NODE_HOME}/cardano-node.service" /etc/systemd/system/cardano-node.service
  sudo chmod 644 /etc/systemd/system/cardano-node.service
  sudo systemctl daemon-reload
  sudo systemctl enable cardano-node
  DglayStyle "systemd サービスを作成しました"
  echo

  #------------------------------------------------------------
  # STEP 8: Mithrilスナップショット同期 (選択時のみ)
  #------------------------------------------------------------
  if [[ "$sync_method" == *Mithril* ]]; then
    echo -e "${WHITE}--------------------------------------------${NC}"
    LglayStyle "Mithrilスナップショット同期を開始します..."
    echo -e "${YELLOW}この作業は30分以上かかる場合があります${NC}"
    echo

    mkdir -p "$HOME/git"
    cd "$HOME/git" || true
    local mithril_release
    mithril_release=$(curl -s --max-time 10 \
      https://api.github.com/repos/input-output-hk/mithril/releases/latest | jq -r '.tag_name')
    if [[ -n "$mithril_release" && "$mithril_release" != "null" ]]; then
      gum spin --spinner dot --title "mithril-client ${mithril_release} をダウンロード中..." -- \
        wget -q \
          "https://github.com/input-output-hk/mithril/releases/download/${mithril_release}/mithril-${mithril_release}-linux-x64.tar.gz" \
          -O mithril.tar.gz
      if gzip -t mithril.tar.gz 2>/dev/null; then
        tar zxf mithril.tar.gz mithril-client > /dev/null 2>&1
        sudo cp mithril-client /usr/local/bin/mithril-client
        sudo chmod +x /usr/local/bin/mithril-client
        rm -f mithril.tar.gz mithril-client
        echo -e "  mithril-client: ${GREEN}$(mithril-client -V 2>/dev/null)${NC}"
      else
        echo -e "${YELLOW}mithril-client のダウンロードをスキップ (既存を使用)${NC}"
        rm -f mithril.tar.gz
      fi
    fi

    local mithril_network
    case "${NODE_CONFIG}" in
      mainnet) mithril_network="release-mainnet" ;;
      preprod) mithril_network="release-preprod" ;;
      preview) mithril_network="pre-release-preview" ;;
      *)       mithril_network="release-mainnet" ;;
    esac

    export AGGREGATOR_ENDPOINT="https://aggregator.${mithril_network}.api.mithril.network/aggregator"

    GENESIS_VERIFICATION_KEY=$(wget -q -O - \
      "https://raw.githubusercontent.com/input-output-hk/mithril/main/mithril-infra/configuration/${mithril_network}/genesis.vkey" \
      2>/dev/null)
    export GENESIS_VERIFICATION_KEY

    ANCILLARY_VERIFICATION_KEY=$(wget -q -O - \
      "https://raw.githubusercontent.com/input-output-hk/mithril/main/mithril-infra/configuration/${mithril_network}/ancillary.vkey" \
      2>/dev/null)
    export ANCILLARY_VERIFICATION_KEY
    export SNAPSHOT_DIGEST="latest"

    if [[ -z "$GENESIS_VERIFICATION_KEY" || -z "$ANCILLARY_VERIFICATION_KEY" ]]; then
      echo -e "${RED}Mithril検証キーの取得に失敗しました。ノードを通常起動します。${NC}"
    else
      rm -rf "${NODE_HOME}/db"
      LglayStyle "Mithrilスナップショットをダウンロード中..."
      mithril-client cardano-db download \
        --download-dir "${NODE_HOME}" \
        --include-ancillary latest
      if [ $? -ne 0 ]; then
        echo -e "${RED}スナップショットのダウンロードに失敗しました${NC}"
        echo -e "${YELLOW}ノードを起動して通常同期で復旧してください${NC}"
      else
        DglayStyle "スナップショットを復元しました"
      fi
    fi
    echo
  fi

  #------------------------------------------------------------
  # STEP 9: ノード起動
  #------------------------------------------------------------
  LglayStyle "cardano-node を起動中..."
  sudo systemctl start cardano-node
  sleep 3

  #------------------------------------------------------------
  # STEP 10: 同期確認
  #------------------------------------------------------------
  nodeSyncCheck

  #------------------------------------------------------------
  # 完了サマリー
  #------------------------------------------------------------
  echo
  echo -e "${WHITE}============================================${NC}"
  YellowStyle "ノードインストール完了"
  echo -e "${WHITE}============================================${NC}"
  echo
  printf "  %-16s ${GREEN}%s${NC}\n" "cardano-node:" \
    "$(cardano-node version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1)"
  printf "  %-16s ${GREEN}%s${NC}\n" "cardano-cli:" \
    "$(cardano-cli version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1)"
  echo
  echo -e "${YELLOW}起動ログ確認:${NC}"
  echo "  glive  または  sudo journalctl -u cardano-node -f"
  echo
  Gum_OneSelect "戻る"
}
